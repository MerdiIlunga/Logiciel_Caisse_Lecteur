<Window x:Class="PointOfSaleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Point de Vente - Gestion des Produits" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Gestion des Produits et Reçus" 
                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Contenu principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Gauche : Scan et Recherche -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Scanner un Code-Barres" FontSize="16" Margin="0,0,0,10"/>
                <TextBox x:Name="BarcodeInput" Width="200" Height="30" FontSize="14" 
                         TextChanged="BarcodeInput_TextChanged" GotFocus="BarcodeInput_GotFocus"/>
                <TextBlock Text="Dernier Code-Barres :" FontSize="14" Margin="0,5,0,5"/>
                <TextBlock x:Name="LastScannedBarcode" Text="Aucun" FontSize="14" Foreground="#FF5722" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="ConfirmButton" Content="Confirmer" Width="100" Height="30" 
                            Click="ConfirmButton_Click" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                    <Button x:Name="SearchButton" Content="Rechercher" Width="100" Height="30" 
                            Click="SearchButton_Click" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
                    <Button x:Name="ClearBarcodeButton" Content="Effacer Code-Barres" Width="120" Height="30" 
                            Click="ClearBarcodeButton_Click" Background="#F44336" Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="En attente de scan..." FontSize="14" 
                           Foreground="#333333" Margin="0,0,0,10"/>
                <GroupBox Header="Ajouter un Produit" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Nom du Produit" FontSize="12"/>
                        <TextBox x:Name="ProductNameInput" Width="200" Height="25" Margin="0,0,0,5"/>
                        <TextBlock Text="Prix" FontSize="12"/>
                        <TextBox x:Name="PriceInput" Width="200" Height="25" Margin="0,0,0,5"/>
                        <TextBlock Text="Description" FontSize="12"/>
                        <TextBox x:Name="DescriptionInput" Width="200" Height="50" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Droite : Liste des Produits et Impression -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Produits Scannés" FontSize="16" Margin="0,0,0,10"/>
                <ListView x:Name="ScannedProductsList" Height="200" Margin="0,0,0,10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Code-Barres" Width="120" DisplayMemberBinding="{Binding Barcode}"/>
                            <GridViewColumn Header="Nom" Width="150" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Prix" Width="80" DisplayMemberBinding="{Binding Price, StringFormat=C}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="TotalText" Text="Total : 0,00 $" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button x:Name="PrintReceiptButton" Content="Imprimer le Reçu" Width="150" Height="30" 
                        Click="PrintReceiptButton_Click" Background="#FF9800" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Pied de page -->
        <TextBlock Grid.Row="2" Text="PointOfSaleApp © 2025" 
                   FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,10" Foreground="#666666"/>
    </Grid>
</Window>