<Window x:Class="PointOfSaleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Point de Vente - Système de Gestion" Height="711" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre principal -->
        <TextBlock Grid.Row="0" Text="Système de Gestion de Point de Vente" 
                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- TabControl pour les onglets -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" BorderThickness="1" BorderBrush="#DDDDDD">
            <!-- Onglet 1: Gestion des Produits et Reçus -->
            <TabItem Header="Gestion des Produits" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : Scan et Recherche -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="Scanner un Code-Barres" FontSize="16" Margin="0,0,0,10"/>
                        <TextBox x:Name="BarcodeInput" Width="200" Height="30" FontSize="14" 
                                 TextChanged="BarcodeInput_TextChanged" GotFocus="BarcodeInput_GotFocus"/>
                        <TextBlock Text="Dernier Code-Barres :" FontSize="14" Margin="0,5,0,5"/>
                        <TextBlock x:Name="LastScannedBarcode" Text="Aucun" FontSize="14" Foreground="#FF5722" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="ConfirmButton" Content="Confirmer" Width="100" Height="30" 
                                    Click="ConfirmButton_Click" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                            <Button x:Name="SearchButton" Content="Rechercher" Width="100" Height="30" 
                                    Click="SearchButton_Click" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
                            <Button x:Name="ClearBarcodeButton" Content="Effacer Code-Barres" Width="120" Height="30" 
                                    Click="ClearBarcodeButton_Click" Background="#F44336" Foreground="White"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="En attente de scan..." FontSize="14" 
                                   Foreground="#333333" Margin="0,0,0,10"/>
                        <GroupBox Header="Ajouter un Produit" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Nom du Produit" FontSize="12"/>
                                <TextBox x:Name="ProductNameInput" Width="200" Height="25" Margin="0,0,0,5"/>
                                <TextBlock Text="Prix" FontSize="12"/>
                                <TextBox x:Name="PriceInput" Width="200" Height="25" Margin="0,0,0,5"/>
                                <TextBlock Text="Description" FontSize="12"/>
                                <TextBox x:Name="DescriptionInput" Width="200" Height="50" AcceptsReturn="True"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Droite : Liste des Produits et Impression -->
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="Produits Scannés" FontSize="16" Margin="0,0,0,10"/>
                        <ListView x:Name="ScannedProductsList" Height="200" Margin="0,0,0,10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Code-Barres" Width="120" DisplayMemberBinding="{Binding Barcode}"/>
                                    <GridViewColumn Header="Nom" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Prix" Width="80" DisplayMemberBinding="{Binding Price, StringFormat=C}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="TotalText" Text="Total : 0,00 €" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button x:Name="PrintReceiptButton" Content="Imprimer le Reçu" Width="150" Height="30" 
                                Click="PrintReceiptButton_Click" Background="#FF9800" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Onglet 2: Gestion d'Accès RFID -->
            <TabItem Header="Gestion d'Accès RFID" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre de l'onglet -->
                    <TextBlock Grid.Row="0" Text="Gestion des Accès RFID" 
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- Contenu principal de l'onglet RFID -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section supérieure - Gestion des utilisateurs -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Gauche: Ajouter/Modifier des utilisateurs -->
                            <GroupBox Grid.Column="0" Header="Ajouter/Modifier un Utilisateur" Padding="10" Margin="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="ID Carte (CardID)" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UserIdInput" Height="25" Margin="0,0,0,10"/>

                                    <TextBlock Text="Nom" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UserNameInput" Height="25" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AddUserButton" Content="Ajouter" Width="90" 
                                                Height="30" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"
                                                Click="AddUserButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Droite: Liste des utilisateurs -->
                            <GroupBox Grid.Column="1" Header="Liste des Utilisateurs" Padding="10">
                                <Grid>
                                    <ListView x:Name="UsersList" MinHeight="180">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ID Utilisateur" Width="100" DisplayMemberBinding="{Binding IdUser}"/>
                                                <GridViewColumn Header="ID Carte" Width="150" DisplayMemberBinding="{Binding CardID}"/>
                                                <GridViewColumn Header="Nom" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="Actions" Width="100">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Supprimer" Width="80" Height="25" 
                                                                    Background="#F44336" Foreground="White"
                                                                    Click="DeleteUserButton_Click"
                                                                    Tag="{Binding IdUser}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </GroupBox>
                        </Grid>

                        <!-- Section inférieure - Historique des scans -->
                        <GroupBox Header="Historique des Scans RFID" Padding="10" Height="268" VerticalAlignment="Center" Grid.Row="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Filtres pour l'historique -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="RefreshHistoryButton" Content="Actualiser" Width="90" 
                                            Height="25" Margin="10,0,0,0" Background="#9E9E9E" Foreground="White"
                                            Click="RefreshHistoryButton_Click"/>
                                </StackPanel>

                                <!-- Liste des scans -->
                                <ListView x:Name="ScanHistoryList" Grid.Row="1" Margin="0,0,0,10">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID Scan" Width="60" DisplayMemberBinding="{Binding ScanID}"/>
                                            <GridViewColumn Header="ID Carte" Width="150" DisplayMemberBinding="{Binding CardID}"/>
                                            <GridViewColumn Header="Date et Heure" Width="150" DisplayMemberBinding="{Binding ScanTime, StringFormat=dd/MM/yyyy HH:mm:ss}"/>
                                            <GridViewColumn Header="Rôle" Width="100" DisplayMemberBinding="{Binding Role}"/>
                                            <GridViewColumn Header="Accès" Width="80" DisplayMemberBinding="{Binding Access}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Boutons d'export -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Pied de page -->
        <TextBlock Grid.Row="2" Text="PointOfSaleApp © 2025" 
                   FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,10" Foreground="#666666"/>
    </Grid>
</Window>